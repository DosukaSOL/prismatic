diff --git a/src/GPU3D_Soft.cpp b/src/GPU3D_Soft.cpp
index e6202700..80145784 100644
--- a/src/GPU3D_Soft.cpp
+++ b/src/GPU3D_Soft.cpp
@@ -1849,4 +1849,34 @@ u32* SoftRenderer3D::GetLine(int line)
     return ScrolledLine;
 }
 
+// PRISMATIC: like GetLine, but returns the 24-bit depth buffer scanline. Meant
+// to be read after a frame finishes (no scanline semaphore wait). Applies the
+// same X-scroll so depth aligns pixel-for-pixel with the colour scanline.
+u32* SoftRenderer3D::GetDepthLine(int line)
+{
+    u32* rawline = &DepthBuffer[(line * ScanlineWidth) + FirstPixelOffset];
+    u16 xpos = GPU3D.RenderXPos;
+    if (xpos == 0)
+        return rawline;
+
+    if (xpos & 0x100)
+    {
+        int i = 0, j = xpos;
+        for (; j < 512; i++, j++)
+            ScrolledDepth[i] = 0;
+        for (j = 0; i < 256; i++, j++)
+            ScrolledDepth[i] = rawline[j];
+    }
+    else
+    {
+        int i = 0, j = xpos;
+        for (; j < 256; i++, j++)
+            ScrolledDepth[i] = rawline[j];
+        for (; i < 256; i++)
+            ScrolledDepth[i] = 0;
+    }
+
+    return ScrolledDepth;
+}
+
 }
